{
  "name": "okbrain",
  "version": "0.0.0",
  "description": "Self-hosted, OKF-native personal knowledge manager (TypeScript on Bun).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "okb": "src/cli.ts"
  },
  "scripts": {
    "okb": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --outfile bin/okb src/cli.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.13",
    "sqlite-vec": "^0.1.9",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0"
  }
}
